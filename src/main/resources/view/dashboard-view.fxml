<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.vyorg.clinica.kinal0.controller.DashboardController">
   <children>
      <ImageView fx:id="imagenFondo" pickOnBounds="true">
         <image>
            <Image url="@../img/fondo-dashboar.jpg" />
         </image>
      </ImageView>
      <BorderPane stylesheets="@../ccs/styles.css">
         <left>
            <VBox prefWidth="210.0" styleClass="sidebar-dark" BorderPane.alignment="CENTER">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="100.0" spacing="10.0">
                     <padding>
                        <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
                     </padding>
                     <children>
                        <ImageView fitHeight="48.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../img/icono.png" />
                           </image>
                        </ImageView>
                        <Label styleClass="logo-text-light" text="Clínica&#10;kinal" wrapText="true" />
                     </children>
                  </HBox>
                  <VBox spacing="6.0">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="15.0" />
                     </padding>
                     <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="🏠 Inicio">
                           <styleClass>
                              <String fx:value="nav-button-dark" />
                              <String fx:value="nav-button-dark-selected" />
                           </styleClass>
                        </Button>
                        <Button fx:id="btnMenuUsuarios" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#irAUsuarios" styleClass="nav-button-dark" text="👤 Usuarios" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#irACitas" styleClass="nav-button-dark" text="🗓 Citas" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#irAExpedientes" styleClass="nav-button-dark" text="📄 Expedientes" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#irAEstadisticas" styleClass="nav-button-dark" text="📊 Estadísticas" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </left>
         <center>
            <BorderPane BorderPane.alignment="CENTER">
               <top>
                  <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="top-info-bar" BorderPane.alignment="CENTER">
                     <padding>
                        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                     </padding>
                     <children>
                        <Label styleClass="top-info-title" text="Expedientes Clínicos: Panel Principal" />
                        <Label styleClass="top-info-sep" text="|" />
                        <Label fx:id="lblUsuario" styleClass="top-info-text" text="Usuario: -" />
                        <Label fx:id="lblRol" styleClass="top-info-text" text="Rol: -" />
                        <HBox HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#cerrarSesion" styleClass="btn-cerrar" text="Cerrar sesion" />
                        <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #2d5449; -fx-font-size: 20px; -fx-cursor: hand;" text="🔔" />
                     </children>
                  </HBox>
               </top>
               <center>
                  <StackPane BorderPane.alignment="CENTER">
                     <children>
                        <VBox spacing="20.0">
                           <padding>
                              <Insets bottom="30.0" left="30.0" right="30.0" top="25.0" />
                           </padding>
                           <children>
                              <HBox spacing="15.0">
                                 <children>
                                    <VBox alignment="CENTER" prefHeight="60.0" prefWidth="170.0" styleClass="btn-inicio">
                                       <children>
                                          <Button mnemonicParsing="false" onAction="#irAPacientes" styleClass="btn-pacientes" text="Pacientes" />
                                       </children>
                                    </VBox>
                                    <VBox fx:id="cajaAdministrarUsuarios" alignment="CENTER" prefHeight="60.0" prefWidth="210.0" styleClass="btn-inicio">
                                       <children>
                                          <Button fx:id="btnAdministrarUsuarios" mnemonicParsing="false" onAction="#irAUsuarios" styleClass="btn-pacientes" text="Administrar Usuarios" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <HBox spacing="20.0">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" maxWidth="260.0" prefHeight="90.0" prefWidth="260.0" spacing="14.0" styleClass="stat-card">
                                       <padding>
                                          <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
                                       </padding>
                                       <children>
                                          <VBox alignment="CENTER" prefHeight="46.0" prefWidth="46.0" styleClass="stat-icon-box">
                                             <children>
                                                <Label text="👥">
                                                   <font>
                                                      <Font size="20.0" />
                                                   </font>
                                                </Label>
                                             </children>
                                          </VBox>
                                          <VBox spacing="2.0">
                                             <children>
                                                <Label fx:id="lblTotalPacientes" styleClass="stat-number" text="0" />
                                                <Label styleClass="stat-label" text="Total de Pacientes" />
                                                <Label styleClass="stat-sublabel" text="Total acumulado" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" maxWidth="260.0" prefHeight="90.0" prefWidth="260.0" spacing="14.0" styleClass="stat-card">
                                       <padding>
                                          <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
                                       </padding>
                                       <children>
                                          <VBox alignment="CENTER" prefHeight="46.0" prefWidth="46.0" styleClass="stat-icon-box">
                                             <children>
                                                <Label text="🗂">
                                                   <font>
                                                      <Font size="20.0" />
                                                   </font>
                                                </Label>
                                             </children>
                                          </VBox>
                                          <VBox spacing="2.0">
                                             <children>
                                                <Label fx:id="lblTotalUsuarios" styleClass="stat-number" text="0" />
                                                <Label styleClass="stat-label" text="Usuarios registrados" />
                                                <Label styleClass="stat-sublabel" text="Total acumulado" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </StackPane>
               </center>
            </BorderPane>
         </center>
      </BorderPane>
   </children>
</StackPane>