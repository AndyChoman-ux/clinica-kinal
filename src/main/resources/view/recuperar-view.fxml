            <Image url="@../img/fondo-dashboar.jpg" />
         </image>
      </ImageView>
      <VBox alignment="TOP_CENTER" maxHeight="488.0" maxWidth="340.0" prefHeight="488.0" prefWidth="340.0" spacing="10.0" styleClass="login-card">
