<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="405.0" prefWidth="622.0" spacing="8.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.vyorg.clinica.kinal0.controller.RecuperarController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <Label text="Restablecer contraseña" />

    <Label text="Usuario o correo" />
    <TextField fx:id="campoUsuarioOCorreo" />
    <Button onAction="#solicitarCodigo" text="Enviar código" />

    <Label text="Código de verificación" />
    <TextField fx:id="campoCodigo" />

    <Label text="Nueva contraseña" />
    <PasswordField fx:id="campoNuevaPassword" />

    <Label text="Confirmar contraseña" />
    <PasswordField fx:id="campoConfirmarPassword" />

    <Button onAction="#restablecerPassword" text="Restablecer" />
    <Button onAction="#volverALogin" text="Volver a iniciar sesión" />

</VBox>
